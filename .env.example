# Server Port (Render sets this automatically, default: 3000 or 10000)
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database Configuration (Supabase PostgreSQL)
# ---------------------------------------------------------------------------
# Recommended: Use Supabase Connection String (Session Pooler or Direct)
# NOTE for Render: Use Supabase Connection Pooler (port 6543 or 5432 with pooler host)
# e.g.: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Alternatively, configure individually if not using DATABASE_URL:
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=6543
# DB_USER=postgres.yourprojectref
# DB_PASS=yourpassword
# DB_NAME=postgres
# DB_SSL=true
# DB_SYNCHRONIZE=true

# ---------------------------------------------------------------------------
# Redis / Valkey Configuration
# ---------------------------------------------------------------------------
# On Render: Use the Internal Connection URL from your Render Valkey/Redis instance:
# e.g.: redis://red-xxxxxxxxxxxx:6379
REDIS_URL=redis://localhost:6379

# Alternatively, configure individually:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
